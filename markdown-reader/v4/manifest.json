{
  "manifest_version": 3,
  "name": "Markdown Reader",
  "version": "1.0",
  "description": "Render Markdown files beautifully in Chrome",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css", "themes.css"],
      "js": ["marked.min.js", "content.js"]
    }
  ],
  "permissions": ["activeTab"]
}
