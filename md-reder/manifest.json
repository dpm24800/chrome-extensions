{
  "manifest_version": 3,
  "name": "Markdown Reader",
  "version": "1.0",
  "description": "Render Markdown files with collapsible sidebar, TOC, and file list",
  "permissions": ["activeTab", "scripting"],
  "web_accessible_resources": [
    {
      "resources": ["md-files/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["marked.min.js", "content.js"],
      "css": ["sidebar.css", "style.css"]
    }
  ]
}
